# Copy to .env and replace every value. .env is gitignored.
POSTGRES_USER=festos
POSTGRES_PASSWORD=change-me
POSTGRES_DB=festos
DATABASE_URL=postgresql+psycopg://festos:change-me@127.0.0.1:5432/festos

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
SESSION_HOURS=12
# Set to true when served over HTTPS
COOKIE_SECURE=false

# Shared password for seeded demo accounts. Demo data only.
DEMO_PASSWORD=change-me

# Optional. Without it the assistant runs in offline mode. Backend only; never expose it.
ANTHROPIC_API_KEY=

# Optional Telegram bot. Empty TELEGRAM_BOT_TOKEN disables it. Get a token from @BotFather.
# The bot answers read-only, as the FestOS user named here, with that user's permissions.
# Restrict who can use it with a comma-separated list of chat ids (empty = anyone can).
TELEGRAM_BOT_TOKEN=
TELEGRAM_AS_EMAIL=safety@festos.test
TELEGRAM_ALLOWED_CHAT_IDS=

# Port for docker-compose.prod.yml.
WEB_PORT=8080

# development or production. seed --reset refuses to run in production.
ENVIRONMENT=development
